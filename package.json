{
  "name": "hospital_management",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "npm --prefix frontend run build",
    "seed": "node scripts/seed.js",
    "test": "npm run lint && vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.config.e2e.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "frontend/node_modules/.bin/oxlint src/ tests/ scripts/",
    "lint:web": "npm --prefix frontend run lint",
    "migrate": "node -e \"import('./src/config/migrations.js').then(m => m.runMigrations())\"",
    "seed:demo": "node scripts/seedDemoData.js",
    "db:reset": "node scripts/resetDemoDb.js",
    "migrate:create": "node -e \"import('./src/config/migrations.js').then(m => m.createMigration(process.argv[2] || 'migration'))\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
