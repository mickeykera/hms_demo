NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend.example.com
DB_PATH=./hospital.db

# How many proxy hops to trust when resolving req.ip.
#   unset / 0 / false -> trust nothing (default, correct for a hospital LAN)
#   3                 -> the Render demo, behind Cloudflare
# A client cannot forge the hop count because X-Forwarded-For is append-only
# and proxies only ever append on the right. See docs/deployment-onprem.md.
# TRUST_PROXY=3

# Demo vs hospital. Unset means onprem, which is the safe default: the demo
# flags below are refused at startup unless this is "demo".
# DEPLOYMENT_MODE=onprem

# Demo-only. Both are refused at startup when DEPLOYMENT_MODE is not "demo".
# DEMO_QUICK_LOGIN=true
# SEED_DEMO_DATA=true

# First-run admin, created once if no administrator exists yet. Omit both to use
# the interactive route instead: curl -X POST https://<host>/api/setup/bootstrap-admin
# BOOTSTRAP_ADMIN_USERNAME=hms.admin
# BOOTSTRAP_ADMIN_PASSWORD=generate-with-openssl-rand-base64-18

# Warn once every 5 minutes when req.ip resolves to a private address. Useful
# where the proxy chain is not under your control; noise on a hospital LAN.
# PROXY_IP_WARN=true